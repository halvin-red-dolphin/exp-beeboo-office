# BeeBoo Office SSE bridge — permanent deployment (homelab)
# No external deps: node built-ins + local src imports only.
FROM node:22-alpine
WORKDIR /app
COPY package.json ./
COPY bridge ./bridge
COPY src/translate.js src/ring.js ./src/
ENV BRIDGE_PORT=9901
EXPOSE 9901
CMD ["node", "bridge/server.js"]
